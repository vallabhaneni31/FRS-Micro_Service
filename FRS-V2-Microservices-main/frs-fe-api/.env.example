PORT=8080
CLIENT_ORIGIN=http://localhost:5173
APP_URL=

NODE_ENV=development
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_NAME=FRS
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_KEEPALIVE=true
DB_KEEPALIVE_DELAY_MS=10000
STATEMENT_TIMEOUT_MS=

# Cross-service fallback used by authRoutes.js's forgot-password flow to look
# up accounts that only exist in the retail service's own database.
RETAIL_DB_URL=

# Jetson sidecar reached directly by the API for browser-initiated
# face-embedding enrollment (employeeRoutes.js: /enroll-face).
JETSON_SIDECAR_URL=http://localhost:5000
EDGE_AI_URL=http://localhost:5000

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# Auth mode: 'keycloak' is the only supported value.
AUTH_MODE=keycloak

# Keycloak config (required when AUTH_MODE=keycloak)
KEYCLOAK_URL=http://localhost:9090
KEYCLOAK_REALM=attendance
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=attendance-api
KEYCLOAK_STRICT_AUDIENCE=false
KEYCLOAK_JWKS_URI=
KEYCLOAK_CLOCK_TOLERANCE_SEC=5
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_LOGIN_THEME=

# ==========================================
# Required secrets — the server refuses to boot without these (no fallback
# defaults are allowed in code). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==========================================
# DEVICE_JWT_SECRET is still required at boot (env.js validates it
# unconditionally) because employeeRoutes.js's POST /:employeeId/enroll-face-direct
# route uses authenticateDevice — the one device-JWT route this repo keeps
# whole, per the split plan.
DEVICE_JWT_SECRET=
ENROLLMENT_TOKEN_SECRET=
HRMS_WEBHOOK_API_KEY=
JETSON_WEBHOOK_SECRET=
INTERNAL_SERVICE_SECRET=

# Comma-separated list of emails granted early access to features still in
# private beta (see middleware/testAccessGuard.js). Empty = feature hidden.
BETA_TESTER_EMAILS=

# S-06: Health/metrics endpoint protection
HEALTH_AUTH_TOKEN=
METRICS_AUTH_TOKEN=
HEALTH_IP_ALLOWLIST=
METRICS_IP_ALLOWLIST=

# S3 storage — permanent enrollment/profile photos + Jetson event log uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_LOGS_BUCKET=
AWS_S3_USER_DATA_BUCKET=
# Optional: only set for local/dev testing against MinIO or similar.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# Optional: Redis — distributed rate limiting + cross-process WebSocket
# delivery. Falls back to in-memory/per-process behavior when unset.
REDIS_URL=

# Optional: Kafka — enterprise device-event/AI-detection subscriptions
# consumed to broadcast live updates to the UI (see server.js). Falls back
# to a disabled no-op if unreachable.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=frs-fe-api
KAFKA_GROUP_ID=frs-fe-api-consumer-group
KAFKA_TOPIC_PREFIX=frs.
KAFKA_SSL_ENABLED=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# GDPR data-retention cron (jobs/dataRetentionCron.js)
RETENTION_FACE_EMBEDDINGS_YEARS=3
RETENTION_ATTENDANCE_DAYS=730
RETENTION_AUDIT_LOG_DAYS=365
RETENTION_DEVICE_EVENTS_DAYS=90
RETENTION_GDPR_ERASURE_DAYS=365
SEARCH_HISTORY_RETENTION_DAYS=90

# Device-offline / enrollment-reminder crons
DEVICE_OFFLINE_THRESHOLD_MIN=5
REMINDER_CRON_INTERVAL_MINUTES=15

# AI model drift monitor (weekly)
AI_DRIFT_THRESHOLD=0.03
AI_DRIFT_WINDOW_DAYS=7

# Face matching (used by faceSyncRoutes.js's trigger-enrollment + face config surfaces)
FACE_MATCH_THRESHOLD=0.55

# Attendance write mode (PERF-0001)
ATTENDANCE_WRITE_MODE=sync
ATTENDANCE_ASYNC_TENANTS=

# SMTP — invite / enrollment-reminder / password-reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SERVICE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_REPLY_TO=

# Misc URLs referenced by emails/UI links
ENROLLMENT_PORTAL_URL=
BACKEND_URL=
PUBLIC_BASE_URL=

# Optional: override where generated CSV/report exports are written
# (defaults to ./uploads/reports relative to this service)
# REPORTS_DIR=./uploads/reports

# Optional: Google Calendar API key for fetching public holidays
# GOOGLE_CALENDAR_API_KEY=your_api_key_here
# COMPANY_CALENDAR_ID=
# HOLIDAY_CALENDAR_ID=
# DEFAULT_TIMEZONE=UTC

# Biometric consent policy version stamped on new consent records
BIOMETRIC_CONSENT_VERSION=1.0

INVITE_TOKEN_TTL_HOURS=72
DEVICE_TOKEN_TTL_SECONDS=
HTTP_TIMEOUT_MS=15000

# ==========================================
# Retail vertical (src/retail/) — user/admin-facing routes for the retail
# people-counting/occupancy service, mounted at /api/v1/retail/*. Copied from
# frs-core-api/backend/api-retail (read-only source); see src/retail/db/pool.js.
# This vertical uses its own separate Postgres database, NOT the main DB_*
# connection above.
# ==========================================

# Retail-vertical database (people counting, occupancy, store analytics).
# Already used above by src/db/retailPool.js (corporate-side forgot-password
# cross-DB lookup) — src/retail/db/pool.js reuses the same variable.
# RETAIL_DB_URL=postgresql://postgres:postgres@localhost:5432/retail_intelligence

# Read-only connection to the main FRS database, for cross-DB user/tenant
# lookups from src/retail/middleware/authenticateUser.js. Point this at the
# same database as this service's own DB_HOST/DB_NAME/DB_USER/DB_PASSWORD
# above.
FRS_DB_URL=

# Keycloak realm URL used by src/retail/services/keycloakVerifier.js to verify
# retail user JWTs (dynamic per-realm JWKS fetch — retail tenants can live in
# per-tenant realms). Looks like https://<host>/auth/realms/<default-realm>.
KEYCLOAK_REALM_URL=

# Base URL of the retail frontend, used to build the invite setup link in
# src/retail/routes/settingsRoutes.js (POST /settings/invitations).
RETAIL_APP_URL=

# Base URL of the internal API used by src/retail/routes/inviteRoutes.js and
# settingsRoutes.js to call the Keycloak-provisioning / invite-email internal
# endpoints, authenticated with INTERNAL_SERVICE_SECRET (already defined
# above).
INTERNAL_API_URL=

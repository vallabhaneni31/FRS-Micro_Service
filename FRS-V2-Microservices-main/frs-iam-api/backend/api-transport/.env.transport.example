# ==========================================
# Transport API (backend/api-transport) — Environment Configuration Example
# ==========================================
#
# Note: unlike the Node services, Spring Boot does not read a .env file
# directly — these must be exported as real process environment variables
# (or wired into whatever process manager eventually runs this service).
# This file exists purely as operator-facing documentation, matching the
# repo's existing backend/api-retail/.env.retail.example convention.

PORT=4002

# Transport-vertical database (buses, routes, devices, boarding/deboarding
# events, occupancy). Own, isolated database — see V1__init_transport_schema.sql.
TRANSPORT_DB_URL=jdbc:postgresql://localhost:5432/transport_intelligence
TRANSPORT_DB_USERNAME=
TRANSPORT_DB_PASSWORD=

# Read-only connection to the EXISTING platform database, for tenant_id
# validation only (see FrsReadOnlyDataSourceConfig.java). Must point at the
# same database as backend/api/.env's DB_HOST/DB_NAME/DB_USER/DB_PASSWORD —
# same convention backend/api-retail/.env.retail already uses for FRS_DB_URL.
FRS_DB_URL=jdbc:postgresql://localhost:5432/attendance_intelligence
FRS_DB_USERNAME=
FRS_DB_PASSWORD=

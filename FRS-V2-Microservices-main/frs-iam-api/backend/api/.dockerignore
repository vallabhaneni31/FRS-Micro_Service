# .dockerignore — FIX-032: Exclude secrets and dev files from Docker image

# Version control
.git
.gitignore

# Secrets and environment
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx

# Dev dependencies and caches
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test artifacts
coverage/
.nyc_output/
__tests__/
*.test.js
*.spec.js

# Build tools
.eslintrc*
.prettierrc*
.editorconfig
.semgrep/

# Logs
logs/
*.log

# Temporary uploads (mounted at runtime via volume)
uploads/

# Documentation
docs/
*.md
!README.md

# CI
.github/
.pre-commit-config.yaml

# Audit reports
audit_rbac_report_*.json

# Temp scripts
temp/
backend/temp/

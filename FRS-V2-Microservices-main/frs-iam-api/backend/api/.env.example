PORT=8080
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=FRS
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

EDGE_AI_URL=http://localhost:5000

# Jetson sidecar reached directly by the API for face-embedding enrollment.
# Points at a specific physical device — set per environment, never hardcode.
JETSON_SIDECAR_URL=http://localhost:5000

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# Auth mode: 'keycloak' is the only supported value.
# Legacy 'api' code paths exist but are deprecated and will be removed.
AUTH_MODE=keycloak

# Keycloak config (only needed when AUTH_MODE=keycloak)
KEYCLOAK_URL=http://localhost:9090
KEYCLOAK_REALM=attendance

# VLM photo-quality gate for visitor_buffer promotion — self-hosted moondream2
# microservice on loopback (backend/api/scripts/vlm_quality_service.py).
# Disabled by default: an outage of this optional service must never block
# visitor promotion (visitorValidationService fails open on any error).
VLM_QUALITY_GATE_ENABLED=false
VLM_QUALITY_GATE_URL=http://127.0.0.1:5065
VLM_QUALITY_GATE_TIMEOUT_MS=60000
VLM_QUALITY_GATE_CONCURRENCY=5

# Read directly by vlm_quality_service.py itself (via python-dotenv), not by
# the Node backend — kept here so the model choice lives in one place instead
# of shell-exported env vars. VLM_QUALITY_PORT must match the port in
# VLM_QUALITY_GATE_URL above.
VLM_QUALITY_PORT=5065
VLM_MODEL_ID=vikhyatk/moondream2
VLM_MODEL_REVISION=2024-08-26
VLM_DEVICE=cpu

# ==========================================
# Required secrets — the server refuses to boot without these (no fallback
# defaults are allowed in code). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==========================================
DEVICE_JWT_SECRET=
ENROLLMENT_TOKEN_SECRET=
HRMS_WEBHOOK_API_KEY=

# Comma-separated list of emails granted early access to features still in
# private beta (see middleware/testAccessGuard.js). Empty = feature hidden.
BETA_TESTER_EMAILS=

# Optional: override where generated CSV report exports are written
# (defaults to ./uploads/reports relative to this service)
# REPORTS_DIR=./uploads/reports

# Optional: Google Calendar API key for fetching public holidays
# If not provided, the system will use a limited set of fallback holidays
# Get your API key from: https://developers.google.com/calendar/api/quickstart/js
# GOOGLE_CALENDAR_API_KEY=your_api_key_here

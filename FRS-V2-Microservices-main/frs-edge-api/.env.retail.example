# ==========================================
# Retail vertical (src/retail/) — Environment Configuration Example
#
# Only the two vars actually used by the device-facing retail code copied
# into this repo (src/retail/db/pool.js). Copy to .env.retail and fill in
# real values; never commit .env.retail itself. This is a separate database
# from the one src/db/pool.js (DB_HOST/DB_NAME/...) connects to.
# ==========================================

# Retail-vertical database (people counting, occupancy, store analytics)
RETAIL_DB_URL=postgresql://postgres:postgres@localhost:5432/retail_intelligence

# Read-only connection to the main FRS database, for cross-DB user/tenant
# lookups (required by src/retail/db/pool.js even though the device-only
# routes copied here don't themselves query it — retail's own pool.js
# throws at startup if this is unset). Must point at the same database as
# this service's own DB_HOST/DB_NAME/DB_USER/DB_PASSWORD in .env.
FRS_DB_URL=postgresql://postgres:postgres@localhost:5432/attendance_intelligence

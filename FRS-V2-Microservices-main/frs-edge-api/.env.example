PORT=8080
NODE_ENV=development
CLIENT_ORIGIN=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=FRS
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ==========================================
# Required secrets — the server refuses to boot without these (no fallback
# defaults are allowed in code). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==========================================
DEVICE_JWT_SECRET=
ENROLLMENT_TOKEN_SECRET=

# S3 storage — Jetson event/attendance photos (logs bucket) and permanent
# enrollment photos (user-data bucket). See src/services/storageService.js.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_LOGS_BUCKET=
AWS_S3_USER_DATA_BUCKET=
# Optional: only set for local/dev testing against MinIO or similar.
# AWS_S3_ENDPOINT=
# AWS_S3_FORCE_PATH_STYLE=false

# Kafka — device event ingest pipeline (POST /api/events) and the PERF-0001
# write-behind attendance ingest worker.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=frs-edge-api
KAFKA_GROUP_ID=frs-edge-api-consumer-group
KAFKA_TOPIC_PREFIX=frs.
KAFKA_SSL_ENABLED=false
# KAFKA_SASL_MECHANISM=
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Redis — distributed rate limiting (rateLimit.js), response/lookup caching
# (services/cache.js), and cross-process WebSocket broadcast delivery to
# frs-fe-api's Socket.IO server (websocket/redisEmitter.js). Optional but
# strongly recommended once more than one instance/process is running.
# REDIS_URL=redis://localhost:6379

# PERF-0001: write-behind attendance ingest dual-write flag.
#   'sync'  (default) — writes on the request path
#   'async' — publishes device-originated marks to Kafka, worker applies them
ATTENDANCE_WRITE_MODE=sync
ATTENDANCE_ASYNC_TENANTS=

# Face recognition match threshold (FaceController.recognizeAndMark / FaceDB)
FACE_MATCH_THRESHOLD=0.50
FACE_DB_PATH=./data/face_db.sqlite

# EdgeAI sidecar — used by FaceController's imageUrl/file-upload recognition
# paths (the primary Jetson-embedding path bypasses this entirely).
EDGE_AI_URL=http://localhost:5000

# Health/metrics endpoint protection (optional)
# HEALTH_AUTH_TOKEN=
# HEALTH_IP_ALLOWLIST=

# Public base URL this service is reachable at — used to build bootstrap /
# enrollment-photo URLs handed back to devices.
# PUBLIC_BASE_URL=
# BACKEND_URL=

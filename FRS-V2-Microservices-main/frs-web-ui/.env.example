# ==========================================
# Frontend (apps/web) — Environment Configuration Example
# ==========================================
# Backend/server config lives in apps/api/.env.example — do not duplicate
# backend-only settings (DB_*, KEYCLOAK_JWKS_URI, DEVICE_JWT_SECRET, etc.) here.

# Auth mode: "keycloak" (OIDC via Keycloak) or "mock" (local fixture data, dev only)
VITE_AUTH_MODE=keycloak

# Backend API base path/URL as seen by the browser
VITE_API_BASE_URL=/api
VITE_API_URL=http://localhost:8080

# WebSocket origin (points at the backend root, NOT /api)
VITE_WS_URL=http://localhost:8080

# Keycloak (public client config only — no secrets belong here)
VITE_KEYCLOAK_URL=http://localhost:9090
VITE_KEYCLOAK_REALM=attendance
VITE_KEYCLOAK_CLIENT_ID=attendance-frontend

# Base domain the SPA is served from (used for cookie/redirect config)
VITE_APP_BASE_DOMAIN=localhost
